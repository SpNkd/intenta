# Local development defaults. Do not use these values in production.
APP_ENV=development
# PostgreSQL used by FastAPI, Alembic, and integration tests.
DATABASE_URL=postgresql+psycopg://intenta:intenta@127.0.0.1:5433/intenta

# Browser requests /api/* from Next.js; the dev server proxies them here.
API_PROXY_TARGET=http://127.0.0.1:8000

# Static Supabase frontend. These values are public browser configuration, not
# database or service-role credentials.
NEXT_PUBLIC_SUPABASE_URL=https://ksltazqhrimgkcttehlp.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<Supabase-publishable-key>

# Session cookie and same-origin CSRF settings.
SESSION_COOKIE_NAME=intenta_session
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Local-only value. Production must supply a strong independent secret.
RECOVERY_RATE_LIMIT_HMAC_KEY=local-development-only-change-me
# Recovery limits are PostgreSQL-backed and shared by all API workers.
RECOVERY_NETWORK_RATE_LIMIT_PER_MINUTE=10
RECOVERY_PUBLIC_ID_RATE_LIMIT_PER_MINUTE=5
RECOVERY_ISSUANCE_NETWORK_RATE_LIMIT_PER_MINUTE=5
RECOVERY_ISSUANCE_IDENTITY_RATE_LIMIT_PER_MINUTE=5
# Argon2id jobs run off the event loop; cap simultaneous memory-intensive jobs.
ARGON2_MAX_CONCURRENCY=2

# Production: supply every value below through your platform secret/config manager.
# APP_ENV=production
# DATABASE_URL=postgresql+psycopg://<app-user>:<secret>@<private-db-host>/intenta
# ALLOWED_ORIGINS=https://intenta.example
# SESSION_COOKIE_NAME=__Host-intenta_session
# SESSION_COOKIE_SECURE=true
# RECOVERY_RATE_LIMIT_HMAC_KEY=<independent-random-secret-at-least-32-characters>
# TRUSTED_PROXY_CIDRS=<platform-ingress-CIDR>[,<additional-CIDR>]
# API_DOCS_ENABLED=false
# DEBUG=false
