# PostgreSQL used by FastAPI, Alembic, and integration tests.
DATABASE_URL=postgresql+psycopg://intenta:intenta@127.0.0.1:5433/intenta

# Browser requests /api/* from Next.js; the dev server proxies them here.
API_PROXY_TARGET=http://127.0.0.1:8000

# Session cookie and same-origin CSRF settings.
SESSION_COOKIE_NAME=intenta_session
SESSION_COOKIE_SECURE=false
ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
# Local-only value. Production must supply a strong independent secret.
RECOVERY_RATE_LIMIT_HMAC_KEY=local-development-only-change-me
